<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATH" value="./logs/gateway"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n"/>

    <!--
      ============================================================================
      性能关键配置：网关日志级别已从 TRACE/DEBUG 下调到 WARN
      ============================================================================
      背景：压测实测「经网关」吞吐仅为「直连后端」的 48%（325 QPS vs 672 QPS），
            且网关并发 40 即回落。根因是网关为每个请求产生大量【同步】日志：

              org.springframework.cloud.gateway       = TRACE  → 路由匹配/断言/过滤器全过程
              reactor.netty.http.server               = DEBUG  → 每个 HTTP 请求报文
              reactor.netty.http.client               = DEBUG  → 每个下游响应报文
              org.springframework.cloud.loadbalancer  = DEBUG  → 每次服务实例选择

            网关是所有请求的必经入口，单请求被放大成数十行日志；
            而 ConsoleAppender 的同步写锁会成为全局串行化点 ——
            Netty 事件循环线程被日志 I/O 阻塞，异步优势完全丧失。

      排查阶段如需重新打开：把下面 logger 改回 TRACE/DEBUG 即可，
      但【压测/生产必须保持 WARN】。
      ============================================================================
    -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 网关核心链路：排查时改 TRACE，压测时保持 WARN -->
    <logger name="org.springframework.cloud.gateway" level="WARN"/>
    <logger name="org.springframework.cloud.gateway.route.RouteDefinitionRouteLocator" level="WARN"/>
    <logger name="org.springframework.cloud.loadbalancer" level="WARN"/>

    <!-- Reactor Netty 报文级日志：最大的日志放大器，压测必须关 -->
    <logger name="reactor.netty.http.server" level="WARN"/>
    <logger name="reactor.netty.http.client" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>

    <!-- Nacos 配置加载：启动期有用，运行期无用 -->
    <logger name="com.alibaba.cloud.nacos.configdata" level="WARN"/>
    <logger name="com.alibaba.cloud.nacos" level="WARN"/>
    <logger name="org.springframework.boot.context.config" level="WARN"/>
    <logger name="org.springframework.cloud.config" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>

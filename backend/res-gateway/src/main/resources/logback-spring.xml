<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATH" value="./logs/gateway"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!--  官方 Gateway 日志：看路由匹配全过程          -->
    <!-- ============================================ -->
    <!-- 路由匹配、断言评估、过滤器执行 -->
    <logger name="org.springframework.cloud.gateway" level="TRACE"/>
    <!-- 路由定位器（刷新路由时触发） -->
    <logger name="org.springframework.cloud.gateway.route.RouteDefinitionRouteLocator" level="INFO"/>
    <!-- 负载均衡 -->
    <logger name="org.springframework.cloud.loadbalancer" level="DEBUG"/>

    <!-- ============================================ -->
    <!--  Reactor Netty 底层请求/响应日志（wiretap）   -->
    <!-- ============================================ -->
    <logger name="reactor.netty.http.server" level="DEBUG"/>
    <logger name="reactor.netty.http.client" level="DEBUG"/>

    <!-- ============================================ -->
    <!--  Nacos 配置中心加载日志                       -->
    <!-- ============================================ -->
    <!-- Nacos ConfigData 加载器（核心） -->
    <logger name="com.alibaba.cloud.nacos.configdata" level="DEBUG"/>
    <!-- Nacos 配置客户端 -->
    <logger name="com.alibaba.cloud.nacos" level="INFO"/>
    <!-- Spring Boot 配置加载框架 -->
    <logger name="org.springframework.boot.context.config" level="DEBUG"/>
    <!-- Spring Cloud Config -->
    <logger name="org.springframework.cloud.config" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
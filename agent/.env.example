# ============================================
# 外卖平台 AI 客服 Agent —— 环境变量模板
# 复制本文件为 .env 后填入你自己的值（.env 已被 .gitignore 忽略，不会入库）
# ============================================

# ---------- LLM（OpenAI 兼容：DeepSeek / OpenAI / 通义等） ----------
# DeepSeek 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 如需切换到 OpenAI / 通义等，改下面三个即可（与上面 DEEPSEEK_* 二选一）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------- LLM（Ollama 本地，无需 Key，推荐离线跑通） ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ---------- LLM 后端选择 ----------
# auto（默认）/ openai / ollama
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.3

# ---------- Embedding（知识库向量化） ----------
# local（ChromaDB 内置）/ ollama（离线推荐）/ openai
EMBEDDING_PROVIDER=local
EMBEDDING_OLLAMA_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Java 微服务网关地址（AI 服务从这里调 Java 后端） ----------
JAVA_GATEWAY_URL=http://localhost:10002
# 离线演示：true 时工具返回模拟数据，无需真实 Java 后端
MOCK_JAVA=false
JAVA_HTTP_TIMEOUT=10

# ---------- AI 服务自身 ----------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# ---------- 检索参数 ----------
RAG_TOP_K=3
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=faq_knowledge
